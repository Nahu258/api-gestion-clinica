# ==========================================================================
# Variables de entorno LOCALES. Este archivo NO se sube a Git (.gitignore).
# Si clonas el repo en otra PC: copia .env.example a .env y completa valores.
# ==========================================================================

# --- Modo de ejecucion ---
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=cambiame-por-una-clave-secreta-generada
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Servidor ---
PORT=8000

# --- Persistencia (SQLite para el AE1) ---
DATABASE_NAME=db.sqlite3

# --- CORS: origenes permitidos para el front (separados por coma) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5500

# ==========================================================================
# AE2 — Servicios de infraestructura (los levanta docker-compose)
# ==========================================================================
# sqlite = como en el AE1 | postgres = usa el contenedor de PostgreSQL
DATABASE_ENGINE=sqlite
POSTGRES_DB=clinica
POSTGRES_USER=clinica
POSTGRES_PASSWORD=clinica
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
