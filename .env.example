# ==========================================================================
# Variables de entorno LOCALES. Este archivo NO se sube a Git (.gitignore).
# Si clonas el repo en otra PC: copia .env.example a .env y completa valores.
# ==========================================================================

# --- Modo de ejecucion ---
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=cambiame-por-una-clave-secreta-generada
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Servidor ---
PORT=8000

# --- Persistencia (SQLite para el AE1) ---
DATABASE_NAME=db.sqlite3

# --- CORS: origenes permitidos para el front (separados por coma) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5500

# --- AE2: Redis (cache del historial e idempotencia de eventos) ---
REDIS_URL=redis://127.0.0.1:6379/1

# --- AE2: RabbitMQ (cola eventos_clinica) ---
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/%2F?connection_attempts=1&socket_timeout=2
