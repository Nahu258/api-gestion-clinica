# ==========================================================================
# Variables de entorno LOCALES. Este archivo NO se sube a Git (.gitignore).
# Si clonas el repo en otra PC: copia .env.example a .env y completa valores.
# ==========================================================================

# --- Modo de ejecucion ---
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=cambiame-por-una-clave-secreta-generada
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,api

# --- Servidor ---
PORT=8000

# --- Persistencia ---
# DATABASE_ENGINE: sqlite | postgres
DATABASE_ENGINE=sqlite
DATABASE_NAME=db.sqlite3

# Para PostgreSQL (si DATABASE_ENGINE=postgres)
POSTGRES_DB=clinica
POSTGRES_USER=clinica
POSTGRES_PASSWORD=clinica
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- CORS: origenes permitidos para el front (separados por coma) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5500

# --- AE2: Redis (cache del historial, reservas temporales y locks) ---
REDIS_URL=redis://127.0.0.1:6379/1

# --- AE2: RabbitMQ (mensajeria de eventos) ---
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/%2F?connection_attempts=3&retry_delay=2

# --- AE3 (Épica 2): Autenticación Google OAuth2 ---
# Obtené tu Client ID en https://console.cloud.google.com/apis/credentials
# Debe ser de tipo "ID de cliente de OAuth 2.0 para aplicación web".
GOOGLE_CLIENT_ID=TU_GOOGLE_CLIENT_ID_ACA
