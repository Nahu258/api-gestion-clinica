    },
    {
      "name": "14 [200] Modificar un solo campo (PATCH)",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "options": { "raw": { "language": "json" } },
          "raw": "{\n  \"estado\": \"confirmado\"\n}"
        },
        "url": { "raw": "{{base}}/turnos/1", "host": ["{{base}}"], "path": ["turnos", "1"] }
      }
    },
    {
      "name": "15 [400] Marcar atendido sin cargar diagnostico",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "options": { "raw": { "language": "json" } },
          "raw": "{\n  \"estado\": \"atendido\"\n}"
        },
        "url": { "raw": "{{base}}/turnos/1", "host": ["{{base}}"], "path": ["turnos", "1"] }
      }
    },
    {
      "name": "16 [200] Reemplazo completo del turno (PUT)",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "options": { "raw": { "language": "json" } },
          "raw": "{\n  \"paciente_nombre\": \"Maria Gomez\",\n  \"paciente_dni\": \"30111222\",\n  \"paciente_telefono\": \"3764-551122\",\n  \"obra_social\": \"IOSFA\",\n  \"profesional\": \"Dra. Laura Benitez\",\n  \"especialidad\": \"clinica_medica\",\n  \"estado\": \"confirmado\",\n  \"fecha_hora\": \"2027-06-01T09:00:00-03:00\",\n  \"motivo_consulta\": \"Reprogramado a pedido del paciente.\",\n  \"diagnostico\": \"\",\n  \"indicaciones\": \"\"\n}"
        },
        "url": { "raw": "{{base}}/turnos/1", "host": ["{{base}}"], "path": ["turnos", "1"] }
      }
    },
    {
      "name": "17 [200] Historial clinico del paciente",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{base}}/pacientes/30111222/historial",
          "host": ["{{base}}"],
          "path": ["pacientes", "30111222", "historial"]
        }
      }
    },
    {
      "name": "18 [404] Historial de paciente sin consultas",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{base}}/pacientes/99999999/historial",
          "host": ["{{base}}"],
          "path": ["pacientes", "99999999", "historial"]
        }
      }
    },
    {
      "name": "19 [204] Eliminar un turno pendiente",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": { "raw": "{{base}}/turnos/4", "host": ["{{base}}"], "path": ["turnos", "4"] }
      }
    },
    {
      "name": "20 [405] Verbo no permitido en la coleccion",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": { "raw": "{{base}}/turnos", "host": ["{{base}}"], "path": ["turnos"] }
