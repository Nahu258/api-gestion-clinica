{
  "info": {
    "name": "AE1 - API Gestion de Turnos e Historial Clinico",
    "description": "Coleccion de live testing del AE1 (PyLP III - UCP/FAITA). El nombre de cada request indica el codigo de estado HTTP esperado. Correr en orden: algunos dependen del estado que deja el anterior.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base", "value": "http://127.0.0.1:8000/api/v1" }
  ],
  "item": [
    {
      "name": "01 [200] Mapa de rutas de la API",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": { "raw": "{{base}}", "host": ["{{base}}"] }
      }
    },
    {
      "name": "02 [200] Listar todos los turnos",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": { "raw": "{{base}}/turnos", "host": ["{{base}}"], "path": ["turnos"] }
      }
    },
    {
      "name": "03 [200] Listar filtrando por estado",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{base}}/turnos?estado=pendiente",
          "host": ["{{base}}"],
          "path": ["turnos"],
          "query": [{ "key": "estado", "value": "pendiente" }]
        }
      }
    },
    {
      "name": "04 [200] Buscar por paciente, DNI o profesional",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{base}}/turnos?buscar=gomez",
          "host": ["{{base}}"],
          "path": ["turnos"],
          "query": [{ "key": "buscar", "value": "gomez" }]
        }
      }
    },
    {
      "name": "05 [400] Filtro con un estado inexistente",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{base}}/turnos?estado=inventado",
          "host": ["{{base}}"],
          "path": ["turnos"],
          "query": [{ "key": "estado", "value": "inventado" }]
        }
      }
    },
    {
      "name": "06 [200] Obtener un turno por id",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": { "raw": "{{base}}/turnos/1", "host": ["{{base}}"], "path": ["turnos", "1"] }
      }
    },
    {
      "name": "07 [404] Obtener un turno inexistente",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": { "raw": "{{base}}/turnos/9999", "host": ["{{base}}"], "path": ["turnos", "9999"] }
      }
    },
    {
      "name": "08 [201] Registrar un turno valido",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "options": { "raw": { "language": "json" } },
          "raw": "{\n  \"paciente_nombre\": \"Ana Lopez\",\n  \"paciente_dni\": \"38444555\",\n  \"paciente_telefono\": \"3764-112233\",\n  \"obra_social\": \"OSDE 310\",\n  \"profesional\": \"Dra. Carla Ibarra\",\n  \"especialidad\": \"ginecologia\",\n  \"fecha_hora\": \"2027-03-15T14:00:00-03:00\",\n  \"motivo_consulta\": \"Control ginecologico anual.\"\n}"
        },
        "url": { "raw": "{{base}}/turnos", "host": ["{{base}}"], "path": ["turnos"] }
      }
    },
    {
      "name": "09 [400] Registrar sin los campos obligatorios",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "options": { "raw": { "language": "json" } },
          "raw": "{}"
        },
        "url": { "raw": "{{base}}/turnos", "host": ["{{base}}"], "path": ["turnos"] }
      }
    },
    {
      "name": "10 [400] DNI con letras",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "options": { "raw": { "language": "json" } },
          "raw": "{\n  \"paciente_nombre\": \"Carlos Ruiz\",\n  \"paciente_dni\": \"ABC123\",\n  \"paciente_telefono\": \"3764-556677\",\n  \"profesional\": \"Dr. Martin Aguirre\",\n  \"especialidad\": \"traumatologia\",\n  \"fecha_hora\": \"2027-05-10T10:00:00-03:00\"\n}"
        },
        "url": { "raw": "{{base}}/turnos", "host": ["{{base}}"], "path": ["turnos"] }
      }
    },
    {
      "name": "11 [400] Especialidad otra sin motivo de consulta",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "options": { "raw": { "language": "json" } },
          "raw": "{\n  \"paciente_nombre\": \"Carlos Ruiz\",\n  \"paciente_dni\": \"29888777\",\n  \"paciente_telefono\": \"3764-556677\",\n  \"profesional\": \"Dr. Martin Aguirre\",\n  \"especialidad\": \"otra\",\n  \"fecha_hora\": \"2027-05-10T10:00:00-03:00\"\n}"
        },
        "url": { "raw": "{{base}}/turnos", "host": ["{{base}}"], "path": ["turnos"] }
      }
    },
    {
      "name": "12 [409] El profesional ya tiene turno en ese horario",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "options": { "raw": { "language": "json" } },
          "raw": "{\n  \"paciente_nombre\": \"Pedro Sosa\",\n  \"paciente_dni\": \"31555444\",\n  \"paciente_telefono\": \"3764-887766\",\n  \"profesional\": \"Dra. Carla Ibarra\",\n  \"especialidad\": \"pediatria\",\n  \"fecha_hora\": \"2027-03-15T14:10:00-03:00\"\n}"
        },
        "url": { "raw": "{{base}}/turnos", "host": ["{{base}}"], "path": ["turnos"] }
