{
  "info": {
    "name": "AE2 - API Gestion de Turnos e Historial Clinico",
    "description": "Coleccion de live testing (PyLP III - UCP/FAITA), actualizada al esquema de AE2: los turnos referencian paciente_id y medico_id del modulo Clinica. Correr despues de `python manage.py seed_turnos` sobre una base nueva y en orden: algunos requests dependen del anterior.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base",
      "value": "http://127.0.0.1:8000/api/v1"
    }
  ],
  "item": [
