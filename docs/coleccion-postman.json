      "name": "01 [200] Mapa de rutas de la API",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base}}",
          "host": [
            "{{base}}"
          ]
        }
      }
    },
    {
      "name": "02 [200] Listar todos los turnos",
