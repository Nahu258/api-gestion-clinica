    },
    {
      "name": "13 [201] Otro profesional SI puede a la misma hora",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "options": { "raw": { "language": "json" } },
          "raw": "{\n  \"paciente_nombre\": \"Pedro Sosa\",\n  \"paciente_dni\": \"31555444\",\n  \"paciente_telefono\": \"3764-887766\",\n  \"profesional\": \"Dr. Nicolas Ferreyra\",\n  \"especialidad\": \"cardiologia\",\n  \"fecha_hora\": \"2027-03-15T14:00:00-03:00\",\n  \"motivo_consulta\": \"Chequeo pre-competencia deportiva.\"\n}"
        },
        "url": { "raw": "{{base}}/turnos", "host": ["{{base}}"], "path": ["turnos"] }
